    "tier:audit": "bun scripts/tier.js audit",
    "tier:checkpoint": "bun scripts/tier.js checkpoint",
    "tier:list": "bun scripts/tier.js list",
    "tier:package": "bun scripts/tier-package.js",
    "tier:install": "bun scripts/tier-install.js",
    "tier:show": "bun scripts/tier.js show",
    "tier:verify": "bun scripts/tier.js verify",
    "npm:pack": "bun scripts/npm-package.js",
    "npm:release:verify": "bun test test/workflow/aggregate_bundle.test.js test/workflow/npm_package.test.js && bun scripts/npm-package.js T6 --install-smoke --publish-dry-run --check-registry",
    "npm:release:latest": "bun scripts/npm-release-latest.js",
    "dsh:bundle": "bun scripts/dsh-bundle.js",
    "dsh:verify": "bun scripts/dsh-verify.js",
