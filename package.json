    "probe:live:futu:us:rights": "bun scripts/futu-us-rights-probe.js --live",
    "probe:live:futu:cn": "bun scripts/futu-cn-ticker-probe.js --live",
    "probe:live:futu:hk": "bun scripts/futu-hk-ticker-probe.js --live",
